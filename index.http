# =========================================================================
# Workflow notes:
# - This file EXTENDS the base {{index-prefix}}-datasource/index/indexer setup
#   with chunking (Split Skill) + embeddings (Azure OpenAI Embedding Skill),
#   following the "Skillset with chunking, single index with parent fields
#   repeated on each chunk (projectionMode: skipIndexingParentDocuments)"
#   pattern from the ACL configuration guide.
# - In this pattern, the PARENT document is never written to the index —
#   only chunks are. ACL fields (UserIds/GroupIds) must therefore be carried
#   onto every chunk via indexProjections.selectors[].mappings, NOT via
#   plain indexer fieldMappings (those are bypassed for the chunk index
#   in this mode).
# - Order: create all-content datasource -> create chunk index (with vector
#   + ACL fields, permissionFilterOption enabled) -> create skillset (split
#   + embed + index projections) -> create all-content indexer -> run ->
#   verify with elevated read.
# =========================================================================


# --------------------------------------------------------------------
# 0. Cleanup any previous chunked pipeline objects (safe to skip on first run)
# --------------------------------------------------------------------
DELETE https://{{searchService}}.search.windows.net/indexers/{{index-prefix}}-pages-indexer?api-version=2026-05-01-preview
Authorization: Bearer {{accessToken}}


###

DELETE https://{{searchService}}.search.windows.net/skillsets/{{index-prefix}}-pages-skillset?api-version=2026-05-01-preview
Authorization: Bearer {{accessToken}}

###

DELETE https://{{searchService}}.search.windows.net/indexes/{{index-prefix}}-chunks-index?api-version=2026-05-01-preview
Authorization: Bearer {{accessToken}}

###


# Cleanup existing datasources.
DELETE https://{{searchService}}.search.windows.net/datasources/{{index-prefix}}-pages-datasource?api-version=2026-05-01-preview
Authorization: Bearer {{accessToken}}


###
# --------------------------------------------------------------------
# 1. All-content datasource (documents + pages + lists).
# --------------------------------------------------------------------
POST https://{{searchService}}.search.windows.net/datasources?api-version=2026-05-01-preview
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "{{index-prefix}}-pages-datasource",
  "type": "sharepoint",
  "indexerPermissionOptions": ["userIds", "groupIds"],

  "credentials": {
    "connectionString": "SharePointOnlineEndpoint={{sharePointSite}};ApplicationId={{appId}};TenantId={{tenantId}};FederatedCredentialApplicationId={{federated-credential}}"
  },

  "container": {
    "name": "allSiteContent"
  }
}

###


# --------------------------------------------------------------------
# 2. Chunk index — one document per chunk, carries content + vector +
#    ACL fields + parent metadata. permissionFilterOption enabled so
#    query-time ACL filtering is honored on this index.
# --------------------------------------------------------------------
PUT https://{{searchService}}.search.windows.net/indexes/{{index-prefix}}-chunks-index?api-version=2026-05-01-preview
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "{{index-prefix}}-chunks-index",

  
  "sharePointConnectorAppRegistration": {
    "applicationId": "{{appId}}",
    "tenantId": "{{tenantId}}",
    "federatedCredentialId": "{{federated-credential}}"
  },


  "permissionFilterOption": "enabled",
 "fields": [
    { "name": "chunkId", "type": "Edm.String",  "retrievable": true, "filterable": true, "sortable": true, "facetable": false, "searchable": true, "analyzer": "keyword", "key": true},
    { "name": "parentId", "type": "Edm.String", "retrievable": true, "filterable": true, "sortable": false, "facetable": false, "searchable": false},
    { "name": "content", "type": "Edm.String", "retrievable": true, "filterable": false, "sortable": false, "facetable": false, "searchable": true},
    {
      "name": "contentVector",
      "type": "Collection(Edm.Single)",
      "searchable": true,
      "retrievable": false,
      "sortable": false,
      "facetable": false,
      "dimensions": {{embeddingDimensions}},
      "vectorSearchProfile": "{{index-prefix}}-vector-profile"
    },
    { "name": "title", "type": "Edm.String",  "retrievable": true, "filterable": true, "sortable": false, "facetable": false, "searchable": true },
    { "name": "metadata_spo_item_path", "type": "Edm.String", "retrievable": true, "filterable": true, "sortable": false, "facetable": false, "searchable": false},
    { "name": "url", "type": "Edm.String", "retrievable": true, "filterable": false, "sortable": false, "facetable": false, "searchable": false},
    { "name": "metadata_spo_item_last_modified", "type": "Edm.DateTimeOffset", "retrievable": true, "filterable": true, "sortable": true, "facetable": false, "searchable": false},
    {
      "name": "UserIds",
      "type": "Collection(Edm.String)",
      "searchable": false,
      "filterable": true,
      "retrievable": true,
      "sortable": false,
      "facetable": false,
      "permissionFilter": "userIds"
    },
    {
      "name": "GroupIds",
      "type": "Collection(Edm.String)",
      "searchable": false,
      "filterable": true,
      "retrievable": true,
      "sortable": false,
      "facetable": false,
      "permissionFilter": "groupIds"
    }, 
    {
      "name": "SharePointSiteUrl",
      "type": "Edm.String",
      "sharepointSiteUrl": true,
      "searchable": false,
      "filterable": true,
      "retrievable": true,
      "sortable": false,
      "facetable": false
    }
  ],
  "semantic": {
    "defaultConfiguration": "sp-semantic-config",
    "configurations": [
      {
        "name": "sp-semantic-config",
        "prioritizedFields": {
          "prioritizedContentFields": [
            {
              "fieldName": "title"
            },
            {
              "fieldName": "content"
            }
          ]
        },
        "rankingOrder": "BoostedRerankerScore"
      }
    ]
  },
  "vectorSearch": {
    "algorithms": [
      { "name": "{{index-prefix}}-hnsw", "kind": "hnsw" }
    ],
    "profiles": [
      {
        "name": "{{index-prefix}}-vector-profile",
        "algorithm": "{{index-prefix}}-hnsw",
        "vectorizer": "{{index-prefix}}-vectorizer"
      }
    ],
    "vectorizers": [
      {
        "name": "{{index-prefix}}-vectorizer",
        "kind": "azureOpenAI",
        "azureOpenAIParameters": {
          "resourceUri": "{{openAiResourceUri}}",
          "deploymentId": "{{openAiDeploymentId}}",
          "modelName": "{{openAiModelName}}",
          "apiKey": "{{openAiApiKey}}"
        }
      }
    ]
  }
}

###


# --------------------------------------------------------------------
# 3. All-content skillset — chunk + embedding pipeline with ACL
# projections enabled for all ingested content.
# --------------------------------------------------------------------
PUT https://{{searchService}}.search.windows.net/skillsets/{{index-prefix}}-pages-skillset?api-version=2026-05-01-preview
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "{{index-prefix}}-pages-skillset",
  "skills": [
    {
      "@odata.type": "#Microsoft.Skills.Custom.WebApiSkill",
      "name": "#sharepoint-acl-enrichment",
      "description": "Resolve and merge SharePoint ACL tenant IDs.",
      "context": "/document",
      "uri": "https://{{functionAppName}}.azurewebsites.net/api/enrich-sharepoint-acls?code={{aclFunctionKey}}",
      "httpMethod": "POST",
      "timeout": "PT3M",
      "batchSize": 10,
      "degreeOfParallelism": 2,
      "inputs": [
        { "name": "url", "source": "/document/metadata_spo_item_weburi" },
        { "name": "existingUserIds", "source": "/document/metadata_user_ids" },
        { "name": "existingGroupIds", "source": "/document/metadata_group_ids" }
      ],
      "outputs": [
        { "name": "mergedUserIds", "targetName": "mergedUserIds" },
        { "name": "mergedGroupIds", "targetName": "mergedGroupIds" }
      ]
    },
    {
      "@odata.type": "#Microsoft.Skills.Text.SplitSkill",
      "name": "#split",
      "context": "/document",
      "textSplitMode": "pages",
      "maximumPageLength": 2000,
      "pageOverlapLength": 200,
      "inputs": [
        { "name": "text", "source": "/document/content" }
      ],
      "outputs": [
        { "name": "textItems", "targetName": "pages" }
      ]
    },
    {
      "@odata.type": "#Microsoft.Skills.Text.AzureOpenAIEmbeddingSkill",
      "name": "#embed",
      "context": "/document/pages/*",
      "resourceUri": "{{openAiResourceUri}}",
      "deploymentId": "{{openAiDeploymentId}}",
      "modelName": "{{openAiModelName}}",
      "apiKey": "{{openAiApiKey}}",
      "dimensions": {{embeddingDimensions}},
      "inputs": [
        { "name": "text", "source": "/document/pages/*" }
      ],
      "outputs": [
        { "name": "embedding", "targetName": "vector" }
      ]
    }
  ],
  "indexProjections": {
    "selectors": [
      {
        "targetIndexName": "{{index-prefix}}-chunks-index",
        "parentKeyFieldName": "parentId",
        "sourceContext": "/document/pages/*",
        "mappings": [
          { "name": "content", "source": "/document/pages/*" },
          { "name": "contentVector", "source": "/document/pages/*/vector" },

          { "name": "title", "source": "/document/metadata_spo_item_name" },
          { "name": "metadata_spo_item_path", "source": "/document/metadata_spo_item_path" },
          { "name": "url", "source": "/document/metadata_spo_item_weburi" },
          { "name": "metadata_spo_item_last_modified", "source": "/document/metadata_spo_item_last_modified" },

          { "name": "UserIds", "source": "/document/mergedUserIds" },
          { "name": "GroupIds", "source": "/document/mergedGroupIds" },
          {
            "name": "SharePointSiteUrl",
            "source": "/document/metadata_spo_site_url"
          }
        ]
      }
    ],
    "parameters": {
      "projectionMode": "skipIndexingParentDocuments"
    }
  }
}

###
# NOTE: while verifying ACL population, you can temporarily flip
# "retrievable" to true on UserIds/GroupIds (no rebuild required),
# then flip back to false afterward.

# --------------------------------------------------------------------
# 4. All-content indexer -> shared chunk index via all-content skillset.
# Required mapping: metadata_spo_site_asset_item_id -> parentId.
# --------------------------------------------------------------------
POST https://{{searchService}}.search.windows.net/indexers?api-version=2026-05-01-preview
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "{{index-prefix}}-pages-indexer",
  "dataSourceName": "{{index-prefix}}-pages-datasource",
  "targetIndexName": "{{index-prefix}}-chunks-index",
  "skillsetName": "{{index-prefix}}-pages-skillset",

  "fieldMappings": [
    {
      "sourceFieldName": "metadata_spo_site_asset_item_id",
      "targetFieldName": "parentId",
      "mappingFunction": {
        "name": "base64Encode"
      }
    },
    {
      "sourceFieldName": "metadata_spo_site_url",
      "targetFieldName": "SharePointSiteUrl"
    }
  ],

  "parameters": {
    "configuration": {
      "dataToExtract": "contentAndMetadata",
      "failOnUnsupportedContentType": false,
      "failOnUnprocessableDocument": false
    }
  }
}

###



# --------------------------------------------------------------------
# 5. Run all-content indexer (documents + pages + lists).
# --------------------------------------------------------------------
POST https://{{searchService}}.search.windows.net/indexers/{{index-prefix}}-pages-indexer/run?api-version=2026-05-01-preview
Authorization: Bearer {{accessToken}}

